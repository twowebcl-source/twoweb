# TwoWeb — Cabeceras de seguridad (Cloudflare Pages las aplica solas)
# Todo el sitio
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# El panel: no aparece en Google y solo se puede incrustar dentro del mismo sitio
# (lo usa la vista previa del editor de ingreso; otras páginas no pueden, así se evita el "clickjacking")
/panel*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  Cache-Control: no-cache

# La configuración siempre fresca (si cambias config.js, se aplica al tiro)
/config.js
  Cache-Control: no-cache

# App instalable: el service worker y el manifiesto siempre frescos
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# fondos.js siempre fresco
/fondos.js
  Cache-Control: no-cache
